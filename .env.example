# Copy to .env and fill in. .env is gitignored.

NODE_ENV=production

# Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=regional_bot_app
DB_PASSWORD=
DB_DATABASE=regional_bot

# Discord
BOT_TOKEN=
CLIENT_ID=

# Absolute path to the guild config JSON (see config.example.json for the shape).
# Lives outside the repo/build tree so deploys never overwrite it.
CONFIG_PATH=
